#!/usr/bin/env bash
set -euo pipefail

UI_LIB="${HOME}/.local/share/u-install/lib/u-install.sh"
if [[ -f "$UI_LIB" ]]; then
    # shellcheck source=/dev/null
    source "$UI_LIB"
else
    echo "Error: library not found at $UI_LIB" >&2
    echo "Please run the install script first: ./install" >&2
    exit 1
fi

ui_parse_config

usage() {
    cat <<EOF
u-uninstall ${UI_VERSION}

Usage: u-uninstall [OPTIONS] <PACKAGE...>

Options:
  -y, --yes   Assume yes to all prompts
  -h, --help  Show this help message
EOF
}

main() {
    local packages=()
    local auto_yes=0

    for arg in "$@"; do
        case "$arg" in
            -h|--help) usage; exit 0 ;;
            -y|--yes) auto_yes=1 ;;
            -*) ui_warn "Unknown option: $arg" ;;
            *) packages+=("$arg") ;;
        esac
    done

    if [[ ${#packages[@]} -eq 0 ]]; then
        usage
        exit 1
    fi

    for pkg in "${packages[@]}"; do
        ui_info "Processing removal: ${pkg}"

        local source
        source=$(ui_db_get_source "$pkg")

        if [[ -z "$source" ]]; then
            ui_warn "Package '${pkg}' not in local database. Trying auto-detection..."
            local distro
            distro=$(ui_detect_distro)
            case "$distro" in
                arch)
                    pacman -Q "$pkg" >/dev/null 2>&1 && source="native"
                    pacman -Qm "$pkg" >/dev/null 2>&1 && source="aur"
                    ;;
                debian)
                    dpkg -l "$pkg" >/dev/null 2>&1 && source="native"
                    ;;
                fedora|yum)
                    rpm -q "$pkg" >/dev/null 2>&1 && source="native"
                    ;;
            esac
            if [[ -z "$source" ]] && ui_has_nix; then
                nix-env -q "$pkg" >/dev/null 2>&1 && source="nix"
            fi
        fi

        if [[ -z "$source" ]]; then
            ui_err "Package '${pkg}' not found. It may not be installed or was not installed via u-install."
            continue
        fi

        ui_info "Detected source: ${source}"

        case "$source" in
            native)
                if ui_confirm "Remove '${pkg}' via native package manager?" "$auto_yes"; then
                    ui_native_uninstall "$pkg" && ui_db_remove "$pkg"
                fi
                ;;
            nix)
                if ui_confirm "Remove '${pkg}' via Nix?" "$auto_yes"; then
                    ui_nix_uninstall "$pkg" && ui_db_remove "$pkg"
                fi
                ;;
            aur)
                if ui_confirm "Remove '${pkg}' via pacman (AUR)?" "$auto_yes"; then
                    ui_aur_uninstall "$pkg" && ui_db_remove "$pkg"
                fi
                ;;
            *)
                ui_err "Unknown source '${source}' for package '${pkg}'."
                ;;
        esac
    done
}

main "$@"
