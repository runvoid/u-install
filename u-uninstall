#!/usr/bin/env bash
set -euo pipefail
UI_LIB="${HOME}/.local/share/u-install/lib/u-install.sh"
[[ -f "$UI_LIB" ]] && source "$UI_LIB" || { echo "Run ./install first" >&2; exit 1; }
ui_parse_config
usage() { cat <<EOF
u-uninstall ${UI_VERSION}

Usage: u-uninstall [OPTIONS] <PACKAGE...>

Options:
  -y, --yes   Assume yes to all prompts
  -h, --help  Show this help message
EOF
}
main() {
    local packages=() auto_yes=0
    for arg in "$@"; do
        case "$arg" in -h|--help) usage; exit 0 ;; -y|--yes) auto_yes=1 ;; -*) ui_warn "Unknown: $arg" ;; *) packages+=("$arg") ;; esac
    done
    [[ ${#packages[@]} -eq 0 ]] && { usage; exit 1; }
    for pkg in "${packages[@]}"; do
        ui_info "Removing: ${pkg}"
        local src; src=$(ui_db_get_source "$pkg")
        if [[ -z "$src" ]]; then
            ui_warn "Not in DB. Auto-detecting..."
            local distro; distro=$(ui_detect_distro)
            case "$distro" in
                arch) pacman -Q "$pkg" >/dev/null 2>&1 && src="native"; pacman -Qm "$pkg" >/dev/null 2>&1 && src="aur" ;;
                debian) dpkg -l "$pkg" >/dev/null 2>&1 && src="native" ;;
                fedora|yum) rpm -q "$pkg" >/dev/null 2>&1 && src="native" ;;
            esac
            [[ -z "$src" && $(ui_has_nix; nix-env -q "$pkg" >/dev/null 2>&1 && echo 1) ]] && src="nix"
        fi
        [[ -z "$src" ]] && { ui_err "'${pkg}' not found"; continue; }
        case "$src" in
            native) ui_confirm "Remove via native?" "$auto_yes" && ui_native_uninstall "$pkg" && ui_db_remove "$pkg" ;;
            nix)    ui_confirm "Remove via Nix?" "$auto_yes" && ui_nix_uninstall "$pkg" && ui_db_remove "$pkg" ;;
            aur)    ui_confirm "Remove via pacman (AUR)?" "$auto_yes" && ui_aur_uninstall "$pkg" && ui_db_remove "$pkg" ;;
            *)      ui_err "Unknown source: ${src}" ;;
        esac
    done
}
main "$@"
