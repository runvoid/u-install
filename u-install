#!/usr/bin/env bash
set -euo pipefail
UI_LIB="${HOME}/.local/share/u-install/lib/u-install.sh"
if [[ -f "$UI_LIB" ]]; then
    source "$UI_LIB"
else
    echo "Run ./install first" >&2
    exit 1
fi
ui_parse_config

usage() {
    cat <<EOF
u-install ${UI_VERSION}

Install packages from the native package manager, Nix, or the AUR,
auto-detecting the best available source.

Usage: u-install [OPTIONS] <PACKAGE...>
         u-install @<GROUP>
         u-install --profile <NAME>

Options:
  --native        Force native package manager
  --nix           Force Nix
  --aur           Force AUR (Arch-based only)
  --profile       Install packages from a profile list
  --self-update   Update u-install itself
  --dry-run       Show what would be installed without making changes
  -y, --yes       Assume yes to all prompts
  -V, --version   Show version information
  -h, --help      Show this help message
EOF
}

install_profile() {
    local profile="$1"
    local profile_file="${UI_DATA_DIR}/profiles/${profile}.txt"
    [[ -f "$profile_file" ]] || { ui_err "Profile not found: ${profile}"; return 1; }
    ui_info "Installing profile: ${profile}"
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "$line" ]] && continue
        local pkg="$line" pflag=""
        [[ "$line" == *"--"* ]] && { pkg="$(echo "$line" | awk '{print $1}')"; pflag="$(echo "$line" | awk '{print $2}')"; }
        if [[ -n "$pflag" ]]; then
            "${UI_BIN_DIR}/u-install" "$pflag" "$pkg" -y || ui_warn "Profile: failed to install ${pkg}"
        else
            "${UI_BIN_DIR}/u-install" "$pkg" -y || ui_warn "Profile: failed to install ${pkg}"
        fi
    done < "$profile_file"
}

main() {
    local packages=() force_native=0 force_nix=0 force_aur=0 auto_yes=0 profile="" dry_run=0
    for arg in "$@"; do
        case "$arg" in
            -h|--help) usage; exit 0 ;;
            -V|--version) ui_print_version; exit 0 ;;
            --native) force_native=1 ;;
            --nix) force_nix=1 ;;
            --aur) force_aur=1 ;;
            --profile) profile="__next__" ;;
            --self-update) ui_self_update; exit 0 ;;
            --dry-run) dry_run=1 ;;
            -y|--yes) auto_yes=1 ;;
            -*) ui_warn "Unknown option: $arg" ;;
            *)
                if [[ "$profile" == "__next__" ]]; then profile="$arg"; else packages+=("$arg"); fi
                ;;
        esac
    done
    [[ -n "$profile" && "$profile" != "__next__" ]] && { install_profile "$profile"; return 0; }
    [[ ${#packages[@]} -eq 0 ]] && { usage; exit 1; }

    local fc=0
    [[ $force_native -eq 1 ]] && fc=$((fc+1))
    [[ $force_nix -eq 1 ]] && fc=$((fc+1))
    [[ $force_aur -eq 1 ]] && fc=$((fc+1))
    [[ $fc -gt 1 ]] && { ui_err "Only one of --native, --nix, --aur"; exit 1; }

    local distro; distro=$(ui_detect_distro)
    ui_info "Distribution: ${distro}"
    [[ "$dry_run" -eq 1 ]] && ui_info "=== DRY RUN (no changes will be made) ==="

    # Background update check (non-blocking), only for real operations
    (ui_check_for_updates >/dev/null 2>&1 &)

    local total=${#packages[@]} idx=0 ok=0 skip=0 fail=0
    for pkg in "${packages[@]}"; do
        idx=$((idx+1))
        if [[ "$pkg" == @* ]]; then
            if [[ "$dry_run" -eq 1 ]]; then
                ui_info "[DRY-RUN] Would install group: ${pkg#@}"
            else
                ui_install_group "${pkg#@}"
            fi
            continue
        fi

        local pver=""
        if [[ "$pkg" == *=* ]]; then pver="${pkg#*=}"; pkg="${pkg%%=*}"; fi
        ui_valid_pkg_name "$pkg" || { ui_err "Invalid package name: '${pkg}'"; exit 1; }
        ui_info "Processing: ${pkg}${pver:+ @ ${pver}}"
        ui_progress "$idx" "$total" "processing ${pkg}"

        if [[ "$dry_run" -eq 1 ]]; then
            local esrc; esrc=$(ui_db_get_source "$pkg")
            [[ -n "$esrc" ]] && ui_info "[DRY-RUN] Previously installed via ${esrc}"
            if [[ $force_native -eq 1 ]] || [[ $fc -eq 0 ]]; then
                ui_info "[DRY-RUN] Would install '${pkg}' via native: $(ui_dry_run_native "$pkg" "$pver")"
            fi
            if [[ $force_nix -eq 1 ]] || [[ $fc -eq 0 ]]; then
                ui_info "[DRY-RUN] Would install '${pkg}' via Nix: $(ui_dry_run_nix "$pkg")"
            fi
            if [[ $force_aur -eq 1 ]] || [[ $fc -eq 0 ]]; then
                ui_info "[DRY-RUN] Would install '${pkg}' via AUR: $(ui_dry_run_aur "$pkg")"
            fi
            continue
        fi

        if ui_is_critical "$pkg"; then
            ui_warn "'${pkg}' is a critical system package"
            if ! ui_confirm_critical "Really install critical package '${pkg}'?"; then
                ui_info "Skipped ${pkg}"
                skip=$((skip+1))
                continue
            fi
        fi

        local esrc; esrc=$(ui_db_get_source "$pkg")
        if [[ -n "$esrc" ]] && ! ui_confirm "Reinstall?" "$auto_yes"; then
            ui_info "Skipped ${pkg} (already installed via ${esrc})"
            skip=$((skip+1))
            continue
        fi

        local installed=0 src_used="" declined=0 install_err=0
        if [[ $force_native -eq 1 ]]; then
            if ui_native_search "$pkg"; then
                ui_confirm "Install via native?" "$auto_yes" \
                    && { ui_native_install "$pkg" "$pver" && installed=1 && src_used="native" || install_err=1; } \
                    || declined=1
            else
                ui_err "Not found in native"
                fail=$((fail+1))
                continue
            fi
        elif [[ $force_nix -eq 1 ]]; then
            if ui_ensure_nix; then
                if ui_nix_search "$pkg"; then
                    ui_confirm "Install via Nix?" "$auto_yes" \
                        && { ui_nix_install "$pkg" && installed=1 && src_used="nix" || install_err=1; } \
                        || declined=1
                else
                    ui_err "Not found in nixpkgs"
                    fail=$((fail+1))
                    continue
                fi
            fi
        elif [[ $force_aur -eq 1 ]]; then
            if ui_aur_search "$pkg"; then
                ui_confirm "Install via AUR?" "$auto_yes" \
                    && { ui_aur_install "$pkg" && installed=1 && src_used="aur" || install_err=1; } \
                    || declined=1
            else
                ui_err "Not found in AUR"
                fail=$((fail+1))
                continue
            fi
        else
            local try_native=1 try_nix=1 try_aur=1
            case "$UI_PREFER_SOURCE" in native) try_nix=0; try_aur=0 ;; nix) try_native=0; try_aur=0 ;; aur) try_native=0; try_nix=0 ;; esac

            if [[ $try_native -eq 1 ]] && ui_native_search "$pkg"; then
                ui_confirm "Found in native. Install?" "$auto_yes" \
                    && { ui_native_install "$pkg" "$pver" && installed=1 && src_used="native" || install_err=1; } \
                    || declined=1
            elif [[ $try_nix -eq 1 ]] && ui_nix_search "$pkg"; then
                ui_confirm "Found in nixpkgs. Install?" "$auto_yes" \
                    && { ui_nix_install "$pkg" && installed=1 && src_used="nix" || install_err=1; } \
                    || declined=1
            elif [[ $try_aur -eq 1 && "$distro" == "arch" ]] && ui_aur_search "$pkg"; then
                ui_confirm "Found in AUR. Install?" "$auto_yes" \
                    && { ui_aur_install "$pkg" && installed=1 && src_used="aur" || install_err=1; } \
                    || declined=1
            fi
        fi

        if [[ $installed -eq 1 ]]; then
            ui_db_add "$pkg" "$src_used"
            ui_ok "Installed via ${src_used}"
            ok=$((ok+1))
        elif [[ "$declined" -eq 1 && "$install_err" -eq 0 ]]; then
            ui_info "Skipped ${pkg}"
            skip=$((skip+1))
        else
            ui_err "Could not install '${pkg}'"
            fail=$((fail+1))
        fi
    done
    ui_progress_end

    if [[ "$total" -gt 1 || "$fail" -gt 0 ]]; then
        printf "\n  ${UI_GREEN}${UI_G_OK}${UI_NC} %d installed ${UI_G_INFO} ${UI_DIM}${UI_G_SKIP}${UI_NC} %d skipped ${UI_G_INFO} ${UI_RED}${UI_G_FAIL}${UI_NC} %d failed\n" "$ok" "$skip" "$fail"
    fi
    if [[ "$fail" -gt 0 ]]; then exit 1; fi
}
main "$@"
