#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob

UI_VERSION="1.3.0"
UI_BIN_DIR="${HOME}/.local/bin"
UI_DATA_DIR="${HOME}/.local/share/u-install"
UI_CONFIG_DIR="${HOME}/.config/u-install"

info() { printf "\033[0;34m[install]\033[0m %s\n" "$1"; }
ok()   { printf "\033[0;32m[install]\033[0m %s\n" "$1"; }
warn() { printf "\033[1;33m[install]\033[0m %s\n" "$1"; }
err()  { printf "\033[0;31m[install]\033[0m %s\n" "$1" >&2; }

# --- Detect source directory ---
src_dir="$(cd "$(dirname "$0")" && pwd)"

# --- Uninstall mode ---
if [[ "${1:-}" == "--uninstall" ]]; then
    info "Uninstalling u-install..."
    local_tools=(u-install u-uninstall u-update u-stats u-doctor u-search u-peek u-list u-export u-import u-help u-info u-diff u-sync)
    for t in "${local_tools[@]}"; do
        [[ -f "${UI_BIN_DIR}/${t}" ]] && rm -v "${UI_BIN_DIR}/${t}" && ok "Removed ${t}"
    done
    [[ -d "${UI_DATA_DIR}" ]] && rm -rf "${UI_DATA_DIR}" && ok "Removed ${UI_DATA_DIR}"
    [[ -d "${UI_CONFIG_DIR}" ]] && rm -rf "${UI_CONFIG_DIR}" && ok "Removed ${UI_CONFIG_DIR}"
    warn "PATH entries left in shell rc files; remove them manually if desired."
    ok "Uninstall complete."
    exit 0
fi

info "u-install v${UI_VERSION} installer"

# --- Preflight checks ---
missing_deps=()
for cmd in bash curl git; do
    command -v "$cmd" >/dev/null 2>&1 || missing_deps+=("$cmd")
done
if [[ ${#missing_deps[@]} -gt 0 ]]; then
    err "Missing required tools: ${missing_deps[*]}"
    err "Install them first (e.g. sudo apt install -y ${missing_deps[*]})"
    exit 1
fi

# --- Verify we are inside the project tree ---
if [[ ! -f "${src_dir}/lib/u-install.sh" ]]; then
    err "Cannot find lib/u-install.sh in ${src_dir}"
    err "Run this script from the cloned u-install directory."
    exit 1
fi

tools=(u-install u-uninstall u-update u-stats u-doctor u-search u-peek u-list u-export u-import u-help u-info u-diff u-sync)
missing_tools=()
for t in "${tools[@]}"; do
    [[ -f "${src_dir}/${t}" ]] || missing_tools+=("$t")
done
if [[ ${#missing_tools[@]} -gt 0 ]]; then
    err "Missing tool scripts in ${src_dir}: ${missing_tools[*]}"
    err "Did you clone the full repository?"
    exit 1
fi

# --- Install directories ---
mkdir -p "$UI_BIN_DIR" "${UI_DATA_DIR}/lib" "${UI_DATA_DIR}/profiles" "$UI_CONFIG_DIR"

# --- Copy tools ---
for t in "${tools[@]}"; do
    cp -v "${src_dir}/${t}" "${UI_BIN_DIR}/${t}"
done
chmod +x "${UI_BIN_DIR}"/*

# --- Copy library ---
cp -v "${src_dir}/lib/u-install.sh" "${UI_DATA_DIR}/lib/"

# --- Copy default config (only if missing) ---
if [[ -f "${src_dir}/config/u-install.conf" ]]; then
    if [[ ! -f "${UI_CONFIG_DIR}/u-install.conf" ]]; then
        cp -v "${src_dir}/config/u-install.conf" "${UI_CONFIG_DIR}/u-install.conf"
    else
        info "Config already exists at ${UI_CONFIG_DIR}/u-install.conf (skipped)"
    fi
else
    warn "No default config found at ${src_dir}/config/u-install.conf"
fi

# --- Copy profiles ---
if [[ -d "${src_dir}/profiles" ]]; then
    for f in "${src_dir}/profiles/"*.txt; do
        cp -v "$f" "${UI_DATA_DIR}/profiles/"
    done
else
    warn "No profiles directory found at ${src_dir}/profiles"
fi

# --- Generate shell completions ---
mkdir -p "${UI_DATA_DIR}/completions"

# Bash completion
bash_comp="${UI_DATA_DIR}/completions/u-install.bash"
cat > "$bash_comp" <<'BASHCOMP'
_u_install() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    opts="--native --nix --aur --profile --self-update --dry-run -y --yes -V --version -h --help"

    case "$prev" in
        --profile)
            local profiles
            profiles=$(ls ~/.local/share/u-install/profiles/*.txt 2>/dev/null | xargs -n1 basename | sed 's/\.txt$//')
            COMPREPLY=( $(compgen -W "$profiles" -- "$cur") )
            return 0
            ;;
    esac

    if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
    fi
}
complete -F _u_install u-install

_u_uninstall() {
    local cur opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    opts="--dry-run -y --yes -V --version -h --help"
    [[ "$cur" == -* ]] && COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
}
complete -F _u_uninstall u-uninstall

_u_update() {
    local cur opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    opts="--system --nix --aur --self --dry-run -y --yes -V --version -h --help"
    [[ "$cur" == -* ]] && COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
}
complete -F _u_update u-update

_u_list() {
    local cur opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    opts="--native --nix --aur -V --version -h --help"
    [[ "$cur" == -* ]] && COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
}
complete -F _u_list u-list

_u_info() {
    local cur
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "-V --version -h --help" -- "$cur") )
    fi
}
complete -F _u_info u-info

_u_diff() {
    local cur
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "-V --version -h --help" -- "$cur") )
    else
        COMPREPLY=( $(compgen -f -X '!*.u' -- "$cur") )
    fi
}
complete -F _u_diff u-diff

_u_sync() {
    local cur
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "--dry-run -y --yes -V --version -h --help" -- "$cur") )
    else
        COMPREPLY=( $(compgen -f -X '!*.u' -- "$cur") )
    fi
}
complete -F _u_sync u-sync
BASHCOMP
ok "Generated Bash completions: ${bash_comp}"

# Zsh completion
zsh_comp="${UI_DATA_DIR}/completions/_u-install"
cat > "$zsh_comp" <<'ZSHCOMP'
#compdef u-install u-uninstall u-update u-list u-info u-diff u-sync u-search u-peek u-export u-import u-stats u-doctor u-help

case "$service" in
    u-install)
        _arguments \
            '(--native --nix --aur)--native[Force native package manager]' \
            '(--native --nix --aur)--nix[Force Nix]' \
            '(--native --nix --aur)--aur[Force AUR]' \
            '--profile[Install from profile]:profile:_files -W ~/.local/share/u-install/profiles -g "*.txt"' \
            '--self-update[Update u-install itself]' \
            '--dry-run[Show what would be installed]' \
            '(-y --yes)'{-y,--yes}'[Assume yes]' \
            '(-V --version)'{-V,--version}'[Show version]' \
            '(-h --help)'{-h,--help}'[Show help]'
        ;;
    u-uninstall)
        _arguments \
            '--dry-run[Show what would be removed]' \
            '(-y --yes)'{-y,--yes}'[Assume yes]' \
            '(-V --version)'{-V,--version}'[Show version]' \
            '(-h --help)'{-h,--help}'[Show help]'
        ;;
    u-update)
        _arguments \
            '--system[Update only system packages]' \
            '--nix[Update only Nix packages]' \
            '--aur[Update only AUR packages]' \
            '--self[Update only u-install itself]' \
            '--dry-run[Show what would be updated]' \
            '(-y --yes)'{-y,--yes}'[Assume yes]' \
            '(-V --version)'{-V,--version}'[Show version]' \
            '(-h --help)'{-h,--help}'[Show help]'
        ;;
    u-list)
        _arguments \
            '--native[Show only native packages]' \
            '--nix[Show only Nix packages]' \
            '--aur[Show only AUR packages]' \
            '(-V --version)'{-V,--version}'[Show version]' \
            '(-h --help)'{-h,--help}'[Show help]'
        ;;
    u-diff|u-sync)
        _arguments \
            '--dry-run[Show what would be done]' \
            '(-y --yes)'{-y,--yes}'[Assume yes]' \
            '(-V --version)'{-V,--version}'[Show version]' \
            '(-h --help)'{-h,--help}'[Show help]' \
            '*:file:_files -g "*.u"'
        ;;
    *)
        _arguments \
            '(-V --version)'{-V,--version}'[Show version]' \
            '(-h --help)'{-h,--help}'[Show help]'
        ;;
esac
ZSHCOMP
ok "Generated Zsh completions: ${zsh_comp}"

# --- Detect shell and configure PATH ---
shell_name="${SHELL##*/}"
primary_rc=""
path_line=""

case "$shell_name" in
    bash) primary_rc="$HOME/.bashrc" ;;
    zsh)  primary_rc="$HOME/.zshrc"  ;;
    fish) primary_rc="$HOME/.config/fish/config.fish" ;;
    *)    primary_rc="$HOME/.profile" ;;
esac

case "$shell_name" in
    fish) path_line="fish_add_path $UI_BIN_DIR" ;;
    *)    path_line="export PATH=\"$UI_BIN_DIR:\$PATH\"" ;;
esac

mkdir -p "$(dirname "$primary_rc")"
[[ -f "$primary_rc" ]] || touch "$primary_rc"

if grep -qF "$UI_BIN_DIR" "$primary_rc" 2>/dev/null; then
    info "PATH already configured in ${primary_rc}"
else
    printf '\n# u-install PATH\n%s\n' "$path_line" >> "$primary_rc"
    ok "Added ${UI_BIN_DIR} to PATH in ${primary_rc}"
fi

if [[ "$primary_rc" != "$HOME/.profile" ]]; then
    if ! grep -qF "$UI_BIN_DIR" "$HOME/.profile" 2>/dev/null; then
        printf '\n# u-install PATH fallback\nexport PATH="%s:$PATH"\n' "$UI_BIN_DIR" >> "$HOME/.profile"
        info "Added fallback PATH entry to ~/.profile"
    fi
fi

# --- Source completions in shell rc ---
if [[ "$shell_name" == "bash" ]]; then
    if ! grep -qF "u-install.bash" "$primary_rc" 2>/dev/null; then
        printf '\n# u-install completions\nsource "%s"\n' "$bash_comp" >> "$primary_rc"
        ok "Added Bash completions to ${primary_rc}"
    fi
elif [[ "$shell_name" == "zsh" ]]; then
    if ! grep -qF "completions/_u-install" "$primary_rc" 2>/dev/null; then
        printf '\n# u-install completions\nfpath+=("%s")\n' "${UI_DATA_DIR}/completions" >> "$primary_rc"
        ok "Added Zsh completions to ${primary_rc}"
    fi
fi

# --- Verify installation ---
if [[ -x "${UI_BIN_DIR}/u-install" ]]; then
    ok "u-install binary installed."
else
    err "u-install binary is missing or not executable in ${UI_BIN_DIR}"
    exit 1
fi

if command -v u-install >/dev/null 2>&1; then
    ok "u-install is already available in this session."
    u-install --version 2>/dev/null || true
else
    warn "u-install is NOT in your current PATH yet."
    warn "Run:  source ${primary_rc}"
    warn "Or open a new terminal."
fi

ok "Installation complete."
