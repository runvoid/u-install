#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob

UI_VERSION="1.2.1"
UI_BIN_DIR="${HOME}/.local/bin"
UI_DATA_DIR="${HOME}/.local/share/u-install"
UI_CONFIG_DIR="${HOME}/.config/u-install"

info() { printf "\033[0;34m[install]\033[0m %s\n" "$1"; }
ok()   { printf "\033[0;32m[install]\033[0m %s\n" "$1"; }
warn() { printf "\033[1;33m[install]\033[0m %s\n" "$1"; }
err()  { printf "\033[0;31m[install]\033[0m %s\n" "$1" >&2; }

# --- Detect source directory ---
src_dir="$(cd "$(dirname "$0")" && pwd)"

# --- Uninstall mode ---
if [[ "${1:-}" == "--uninstall" ]]; then
    info "Uninstalling u-install..."
    local_tools=(u-install u-uninstall u-update u-stats u-doctor u-search u-peek u-list u-export u-import u-help)
    for t in "${local_tools[@]}"; do
        [[ -f "${UI_BIN_DIR}/${t}" ]] && rm -v "${UI_BIN_DIR}/${t}" && ok "Removed ${t}"
    done
    [[ -d "${UI_DATA_DIR}" ]] && rm -rf "${UI_DATA_DIR}" && ok "Removed ${UI_DATA_DIR}"
    [[ -d "${UI_CONFIG_DIR}" ]] && rm -rf "${UI_CONFIG_DIR}" && ok "Removed ${UI_CONFIG_DIR}"
    warn "PATH entries left in shell rc files; remove them manually if desired."
    ok "Uninstall complete."
    exit 0
fi

info "u-install v${UI_VERSION} installer"

# --- Preflight checks ---
missing_deps=()
for cmd in bash curl git; do
    command -v "$cmd" >/dev/null 2>&1 || missing_deps+=("$cmd")
done
if [[ ${#missing_deps[@]} -gt 0 ]]; then
    err "Missing required tools: ${missing_deps[*]}"
    err "Install them first (e.g. sudo apt install -y ${missing_deps[*]})"
    exit 1
fi

# --- Verify we are inside the project tree ---
if [[ ! -f "${src_dir}/lib/u-install.sh" ]]; then
    err "Cannot find lib/u-install.sh in ${src_dir}"
    err "Run this script from the cloned u-install directory."
    exit 1
fi

tools=(u-install u-uninstall u-update u-stats u-doctor u-search u-peek u-list u-export u-import u-help)
missing_tools=()
for t in "${tools[@]}"; do
    [[ -f "${src_dir}/${t}" ]] || missing_tools+=("$t")
done
if [[ ${#missing_tools[@]} -gt 0 ]]; then
    err "Missing tool scripts in ${src_dir}: ${missing_tools[*]}"
    err "Did you clone the full repository?"
    exit 1
fi

# --- Install directories ---
mkdir -p "$UI_BIN_DIR" "${UI_DATA_DIR}/lib" "${UI_DATA_DIR}/profiles" "$UI_CONFIG_DIR"

# --- Copy tools ---
for t in "${tools[@]}"; do
    cp -v "${src_dir}/${t}" "${UI_BIN_DIR}/${t}"
done
chmod +x "${UI_BIN_DIR}"/*

# --- Copy library ---
cp -v "${src_dir}/lib/u-install.sh" "${UI_DATA_DIR}/lib/"

# --- Copy default config (only if missing) ---
if [[ -f "${src_dir}/config/u-install.conf" ]]; then
    if [[ ! -f "${UI_CONFIG_DIR}/u-install.conf" ]]; then
        cp -v "${src_dir}/config/u-install.conf" "${UI_CONFIG_DIR}/u-install.conf"
    else
        info "Config already exists at ${UI_CONFIG_DIR}/u-install.conf (skipped)"
    fi
else
    warn "No default config found at ${src_dir}/config/u-install.conf"
fi

# --- Copy profiles ---
if [[ -d "${src_dir}/profiles" ]]; then
    for f in "${src_dir}/profiles/"*.txt; do
        cp -v "$f" "${UI_DATA_DIR}/profiles/"
    done
else
    warn "No profiles directory found at ${src_dir}/profiles"
fi

# --- Detect shell and configure PATH ---
# In WSL the login shell may read .profile instead of .bashrc,
# so we add to the "best" rc file AND ensure .profile also works.
shell_name="${SHELL##*/}"
primary_rc=""
path_line=""

# Determine primary rc file
case "$shell_name" in
    bash) primary_rc="$HOME/.bashrc" ;;
    zsh)  primary_rc="$HOME/.zshrc"  ;;
    fish) primary_rc="$HOME/.config/fish/config.fish" ;;
    *)    primary_rc="$HOME/.profile" ;;
esac

# Build PATH line per shell
case "$shell_name" in
    fish) path_line="fish_add_path $UI_BIN_DIR" ;;
    *)    path_line="export PATH=\"$UI_BIN_DIR:\$PATH\"" ;;
esac

# Ensure rc file exists
mkdir -p "$(dirname "$primary_rc")"
[[ -f "$primary_rc" ]] || touch "$primary_rc"

# Add to primary rc if not already present
if grep -qF "$UI_BIN_DIR" "$primary_rc" 2>/dev/null; then
    info "PATH already configured in ${primary_rc}"
else
    printf '\n# u-install PATH\n%s\n' "$path_line" >> "$primary_rc"
    ok "Added ${UI_BIN_DIR} to PATH in ${primary_rc}"
fi

# Also add to .profile as a fallback for login shells (WSL, SSH, etc.)
if [[ "$primary_rc" != "$HOME/.profile" ]]; then
    if ! grep -qF "$UI_BIN_DIR" "$HOME/.profile" 2>/dev/null; then
        printf '\n# u-install PATH fallback\nexport PATH="%s:$PATH"\n' "$UI_BIN_DIR" >> "$HOME/.profile"
        info "Added fallback PATH entry to ~/.profile"
    fi
fi

# --- Verify installation ---
if [[ -x "${UI_BIN_DIR}/u-install" ]]; then
    ok "u-install binary installed."
else
    err "u-install binary is missing or not executable in ${UI_BIN_DIR}"
    exit 1
fi

# --- Immediate PATH activation hint ---
if command -v u-install >/dev/null 2>&1; then
    ok "u-install is already available in this session."
    u-install --version 2>/dev/null || true
else
    warn "u-install is NOT in your current PATH yet."
    warn "Run:  source ${primary_rc}"
    warn "Or open a new terminal."
fi

ok "Installation complete."
