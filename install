#!/usr/bin/env bash
set -euo pipefail

UI_NAME="u-install"
UI_VERSION="1.1.0"
UI_BIN_DIR="${HOME}/.local/bin"
UI_DATA_DIR="${HOME}/.local/share/u-install"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info() { printf "${BLUE}[install]${NC} %s\n" "$1"; }
ok()   { printf "${GREEN}[install]${NC} %s\n" "$1"; }
warn() { printf "${YELLOW}[install]${NC} %s\n" "$1"; }
err()  { printf "${RED}[install]${NC} %s\n" "$1" >&2; }

check_deps() {
    local missing=()
    for cmd in bash curl git; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing+=("$cmd")
        fi
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        err "Missing dependencies: ${missing[*]}"
        err "Install them with your system package manager first."
        exit 1
    fi
}

main() {
    info "u-install v${UI_VERSION} installer"
    check_deps

    local src_dir
    src_dir="$(cd "$(dirname "$0")" && pwd)"

    info "Installing from: $src_dir"

    mkdir -p "$UI_BIN_DIR"
    mkdir -p "${UI_DATA_DIR}/lib"
    mkdir -p "${UI_DATA_DIR}/profiles"
    mkdir -p "${HOME}/.config/u-install"

    cp -v "$src_dir/u-install" "$UI_BIN_DIR/u-install"
    cp -v "$src_dir/u-uninstall" "$UI_BIN_DIR/u-uninstall"
    cp -v "$src_dir/u-update" "$UI_BIN_DIR/u-update"
    cp -v "$src_dir/u-stats" "$UI_BIN_DIR/u-stats"
    cp -v "$src_dir/u-doctor" "$UI_BIN_DIR/u-doctor"
    cp -v "$src_dir/lib/u-install.sh" "${UI_DATA_DIR}/lib/u-install.sh"

    if [[ ! -f "${HOME}/.config/u-install/u-install.conf" ]]; then
        cp -v "$src_dir/config/u-install.conf" "${HOME}/.config/u-install/u-install.conf"
        info "Default config installed to ~/.config/u-install/u-install.conf"
    fi

    cp -v "$src_dir/profiles/example.txt" "${UI_DATA_DIR}/profiles/example.txt"

    chmod +x "$UI_BIN_DIR/u-install"
    chmod +x "$UI_BIN_DIR/u-uninstall"
    chmod +x "$UI_BIN_DIR/u-update"
    chmod +x "$UI_BIN_DIR/u-stats"
    chmod +x "$UI_BIN_DIR/u-doctor"

    ok "Commands installed to ${UI_BIN_DIR}"

    local shell_rc=""
    case "${SHELL##*/}" in
        bash) shell_rc="$HOME/.bashrc" ;;
        zsh)  shell_rc="$HOME/.zshrc" ;;
        fish) shell_rc="$HOME/.config/fish/config.fish" ;;
        *)    shell_rc="$HOME/.profile" ;;
    esac

    if [[ -n "$shell_rc" && -f "$shell_rc" ]]; then
        if ! grep -q "$UI_BIN_DIR" "$shell_rc" 2>/dev/null; then
            echo "export PATH=\"$UI_BIN_DIR:\$PATH\"" >> "$shell_rc"
            ok "Added ${UI_BIN_DIR} to PATH in ${shell_rc}"
            warn "Restart your terminal or run: source ${shell_rc}"
        else
            info "${UI_BIN_DIR} is already in PATH"
        fi
    fi

    ok "Installation complete."
    info "Run 'u-install --help' after restarting your terminal."
}

main "$@"
