#!/usr/bin/env bash
set -euo pipefail
UI_VERSION="1.2.1"
UI_BIN_DIR="${HOME}/.local/bin"
UI_DATA_DIR="${HOME}/.local/share/u-install"
info() { printf "\033[0;34m[install]\033[0m %s\n" "$1"; }
ok()   { printf "\033[0;32m[install]\033[0m %s\n" "$1"; }
warn() { printf "\033[1;33m[install]\033[0m %s\n" "$1"; }
err()  { printf "\033[0;31m[install]\033[0m %s\n" "$1" >&2; }
info "u-install v${UI_VERSION} installer"
for cmd in bash curl git; do
    command -v "$cmd" >/dev/null 2>&1 || { err "Missing: $cmd"; exit 1; }
done
src_dir="$(cd "$(dirname "$0")" && pwd)"
mkdir -p "$UI_BIN_DIR" "${UI_DATA_DIR}/lib" "${UI_DATA_DIR}/profiles" "${HOME}/.config/u-install"
for f in u-install u-uninstall u-update u-stats u-doctor u-search u-peek u-list u-export u-import u-help; do
    cp -v "$src_dir/$f" "$UI_BIN_DIR/$f"
done
cp -v "$src_dir/lib/u-install.sh" "${UI_DATA_DIR}/lib/"
[[ ! -f "${HOME}/.config/u-install/u-install.conf" ]] && cp -v "$src_dir/config/u-install.conf" "${HOME}/.config/u-install/u-install.conf"
cp -v "$src_dir/profiles/"*.txt "${UI_DATA_DIR}/profiles/"
chmod +x "$UI_BIN_DIR"/u-*
shell_name="${SHELL##*/}"
shell_rc=""
path_line=""
case "$shell_name" in
    bash) shell_rc="$HOME/.bashrc"; path_line="export PATH=\"$UI_BIN_DIR:\$PATH\"" ;;
    zsh)  shell_rc="$HOME/.zshrc";  path_line="export PATH=\"$UI_BIN_DIR:\$PATH\"" ;;
    fish) shell_rc="$HOME/.config/fish/config.fish"; path_line="fish_add_path $UI_BIN_DIR" ;;
    *)    shell_rc="$HOME/.profile"; path_line="export PATH=\"$UI_BIN_DIR:\$PATH\"" ;;
esac
# Create the rc file if it doesn't exist yet (fresh systems may lack it),
# so the PATH entry is actually picked up on the next login.
mkdir -p "$(dirname "$shell_rc")"
[[ -f "$shell_rc" ]] || touch "$shell_rc"
if grep -qF "$UI_BIN_DIR" "$shell_rc" 2>/dev/null; then
    info "PATH already configured in ${shell_rc}"
else
    printf '%s\n' "$path_line" >> "$shell_rc"
    ok "Added ${UI_BIN_DIR} to PATH in ${shell_rc}"
    warn "Restart your terminal or run: source ${shell_rc}"
fi
ok "Installation complete."
