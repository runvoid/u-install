#!/usr/bin/env bash
set -euo pipefail

UI_NAME="u-install"
UI_VERSION="0.0.1-alpha"
UI_BIN_DIR="${HOME}/.local/bin"
UI_CONFIG_DIR="${HOME}/.config/u-install"
UI_DATA_DIR="${HOME}/.local/share/u-install"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info() { printf "${BLUE}[info]${NC} %s\n" "$1"; }
ok()   { printf "${GREEN}[ok]${NC} %s\n" "$1"; }
warn() { printf "${YELLOW}[warn]${NC} %s\n" "$1"; }
err()  { printf "${RED}[err]${NC} %s\n" "$1" >&2; }

check_deps() {
    local missing=()
    for cmd in bash curl git; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing+=("$cmd")
        fi
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        err "Missing dependencies: ${missing[*]}"
        err "Please install them using your system package manager."
        exit 1
    fi
}

ensure_dir() {
    if [[ ! -d "$1" ]]; then
        mkdir -p "$1"
    fi
}

install_from_local() {
    local src_dir
    src_dir="$(cd "$(dirname "$0")" && pwd)"

    info "Installing from local directory: $src_dir"

    ensure_dir "$UI_BIN_DIR"
    ensure_dir "$UI_CONFIG_DIR"
    ensure_dir "$UI_DATA_DIR"
    ensure_dir "$UI_DATA_DIR/lib"

    cp -v "$src_dir/u-install" "$UI_BIN_DIR/"
    cp -v "$src_dir/u-uninstall" "$UI_BIN_DIR/"
    cp -v "$src_dir/u-update" "$UI_BIN_DIR/"
    cp -v "$src_dir/lib/u-install.sh" "$UI_DATA_DIR/lib/"

    chmod +x "$UI_BIN_DIR/u-install"
    chmod +x "$UI_BIN_DIR/u-uninstall"
    chmod +x "$UI_BIN_DIR/u-update"

    ok "Commands installed to $UI_BIN_DIR"
}

install_from_remote() {
    info "Remote installation not implemented in v0.0.1-alpha"
    info "Please clone the repository and run ./install"
    exit 1
}

update_path() {
    local shell_rc=""
    case "${SHELL##*/}" in
        bash) shell_rc="$HOME/.bashrc" ;;
        zsh)  shell_rc="$HOME/.zshrc" ;;
        fish) shell_rc="$HOME/.config/fish/config.fish" ;;
        *)    shell_rc="$HOME/.profile" ;;
    esac

    if [[ -n "$shell_rc" && -f "$shell_rc" ]]; then
        if ! grep -q "$UI_BIN_DIR" "$shell_rc" 2>/dev/null; then
            echo "export PATH="$UI_BIN_DIR:\$PATH"" >> "$shell_rc"
            ok "Added $UI_BIN_DIR to PATH in $shell_rc"
            warn "Please restart your terminal or run: source $shell_rc"
        else
            info "$UI_BIN_DIR is already in PATH"
        fi
    fi
}

main() {
    info "u-install v$UI_VERSION installer"

    check_deps

    if [[ -f "$(dirname "$0")/u-install" ]]; then
        install_from_local
    else
        install_from_remote
    fi

    update_path

    ok "Installation complete!"
    info "Run 'u-install --help' after restarting your terminal."
}

main "$@"
