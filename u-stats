#!/usr/bin/env bash
set -euo pipefail

UI_LIB="${HOME}/.local/share/u-install/lib/u-install.sh"
if [[ -f "$UI_LIB" ]]; then
    # shellcheck source=/dev/null
    source "$UI_LIB"
else
    echo "Error: library not found at $UI_LIB" >&2
    echo "Please run the install script first: ./install" >&2
    exit 1
fi

ui_parse_config

usage() {
    cat <<EOF
u-stats ${UI_VERSION}

Usage: u-stats [OPTIONS]

Options:
  -h, --help  Show this help message
EOF
}

main() {
    for arg in "$@"; do
        case "$arg" in
            -h|--help) usage; exit 0 ;;
        esac
    done

    ui_info "=== u-install Statistics ==="

    local total
    total=$(ui_db_count)
    local native_count
    native_count=$(ui_db_count_by_source "native")
    local nix_count
    nix_count=$(ui_db_count_by_source "nix")
    local aur_count
    aur_count=$(ui_db_count_by_source "aur")

    printf "  Total packages tracked:   %s\n" "$total"
    printf "  Native packages:          %s\n" "$native_count"
    printf "  Nix packages:             %s\n" "$nix_count"
    printf "  AUR packages:             %s\n" "$aur_count"

    if ui_has_nix; then
        local nix_total=0
        local heaviest_pkg=""
        local heaviest_size=0
        while IFS= read -r pkg; do
            [[ -z "$pkg" ]] && continue
            local size
            size=$(ui_nix_pkg_size "$pkg")
            nix_total=$((nix_total + size))
            if [[ "$size" -gt "$heaviest_size" ]]; then
                heaviest_size="$size"
                heaviest_pkg="$pkg"
            fi
        done <<< "$(nix-env -q 2>/dev/null || true)"

        if [[ "$nix_total" -gt 0 ]]; then
            printf "  Nix store total size:     %s\n" "$(ui_human_size "$nix_total")"
            if [[ -n "$heaviest_pkg" ]]; then
                printf "  Heaviest Nix package:     %s (%s)\n" "$heaviest_pkg" "$(ui_human_size "$heaviest_size")"
            fi
        fi
    fi

    if [[ -f "${UI_DATA_DIR}/db/last_update" ]]; then
        printf "  Last system update:       %s\n" "$(cat "${UI_DATA_DIR}/db/last_update")"
    else
        printf "  Last system update:       never\n"
    fi

    printf "\n  Config: ~/.config/u-install/u-install.conf\n"
    printf "  Prefer source:            %s\n" "$UI_PREFER_SOURCE"
    printf "  Parallel downloads:       %s\n" "$UI_PARALLEL_DOWNLOADS"
    printf "  Max AUR parallel builds:  %s\n" "$UI_MAX_AUR_PARALLEL"
    printf "  Cleanup after build:      %s\n" "$([[ "$UI_CLEANUP_AFTER_BUILD" -eq 1 ]] && echo "true" || echo "false")"
}

main "$@"
