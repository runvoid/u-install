#!/usr/bin/env bash
set -euo pipefail
UI_LIB="${HOME}/.local/share/u-install/lib/u-install.sh"
if [[ -f "$UI_LIB" ]]; then
    source "$UI_LIB"
else
    echo "Run ./install first" >&2
    exit 1
fi
ui_parse_config
usage() { cat <<EOF
u-stats ${UI_VERSION}

Show statistics about packages tracked by u-install.

Usage: u-stats [OPTIONS]

Options:
  -V, --version  Show version information
  -h, --help  Show this help message
EOF
}
main() {
    for arg in "$@"; do
        case "$arg" in
            -h|--help) usage; exit 0 ;;
            -V|--version) ui_print_version; exit 0 ;;
        esac
    done
    ui_info "=== Statistics ==="
    printf "  Total tracked:     %s\n" "$(ui_db_count)"
    printf "  Native packages:   %s\n" "$(ui_db_count_by_source "native")"
    printf "  Nix packages:      %s\n" "$(ui_db_count_by_source "nix")"
    printf "  AUR packages:      %s\n" "$(ui_db_count_by_source "aur")"
    if ui_has_nix; then
        local total=0 heaviest="" hsize=0
        while IFS= read -r pkg; do
            [[ -z "$pkg" ]] && continue
            local sz; sz=$(ui_nix_pkg_size "$pkg")
            total=$((total + sz))
            [[ "$sz" -gt "$hsize" ]] && { hsize="$sz"; heaviest="$pkg"; }
        done <<< "$(nix-env -q 2>/dev/null || true)"
        [[ "$total" -gt 0 ]] && printf "  Nix store size:    %s\n" "$(ui_human_size "$total")"
        [[ -n "$heaviest" ]] && printf "  Heaviest Nix pkg:  %s (%s)\n" "$heaviest" "$(ui_human_size "$hsize")"
    fi
    printf "\n  Config file: ~/.config/u-install/u-install.conf\n"
    printf "  Prefer source:     %s\n" "$UI_PREFER_SOURCE"
    printf "  Parallel downloads: %s\n" "$UI_PARALLEL_DOWNLOADS"
    printf "  Cleanup after build: %s\n" "$([[ "$UI_CLEANUP_AFTER_BUILD" -eq 1 ]] && echo "true" || echo "false")"
}
main "$@"
