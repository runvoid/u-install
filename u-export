#!/usr/bin/env bash
set -euo pipefail
UI_LIB="${HOME}/.local/share/u-install/lib/u-install.sh"
if [[ -f "$UI_LIB" ]]; then
    source "$UI_LIB"
else
    echo "Run ./install first" >&2
    exit 1
fi
ui_parse_config
usage() { cat <<EOF
u-export ${UI_VERSION}

Export your u-install setup (installer config + tracked packages) to a
portable .u file. Copy that file to another machine and run \`u-import\`
to reproduce the same configuration and packages.

Usage: u-export [FILE]

Arguments:
  FILE           Output file (default: configuration.u)

Options:
  -V, --version  Show version information
  -h, --help     Show this help message
EOF
}
main() {
    local out="configuration.u"
    for arg in "$@"; do
        case "$arg" in
            -h|--help) usage; exit 0 ;;
            -V|--version) ui_print_version; exit 0 ;;
            -*) ui_warn "Unknown option: $arg" ;;
            *) out="$arg" ;;
        esac
    done
    ui_export_write > "$out"
    ui_uf_sign "$out"
    local n; n="$(ui_db_count)"
    ui_ok "Exported configuration and ${n} package(s) to ${out}"
    if ui_uf_verify "$out"; then
        ui_info "Integrity: sha256 checksum embedded in [meta]"
    else
        ui_warn "Integrity: no sha256 hasher found; file left unsigned"
    fi
    ui_info "Apply on another machine with: u-import ${out}"
}
main "$@"
