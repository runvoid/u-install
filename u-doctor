#!/usr/bin/env bash
set -euo pipefail
UI_LIB="${HOME}/.local/share/u-install/lib/u-install.sh"
[[ -f "$UI_LIB" ]] && source "$UI_LIB" || { echo "Run ./install first" >&2; exit 1; }
ui_parse_config
usage() { cat <<EOF
u-doctor ${UI_VERSION}

Usage: u-doctor [OPTIONS]

Options:
  -h, --help  Show this help message
EOF
}
main() {
    for arg in "$@"; do
        case "$arg" in
            -h|--help) usage; exit 0 ;;
            -V|--version) ui_print_version; exit 0 ;;
        esac
    done
    ui_info "=== Doctor ==="; local issues=0
    printf "\n[Dependencies]\n"
    for cmd in bash curl git; do
        command -v "$cmd" >/dev/null 2>&1 && printf "  [OK] %s\n" "$cmd" || { printf "  [FAIL] %s missing\n" "$cmd"; issues=$((issues+1)); }
    done
    if command -v sudo >/dev/null 2>&1 || command -v doas >/dev/null 2>&1; then printf "  [OK] sudo/doas available\n"; else printf "  [WARN] No sudo/doas\n"; issues=$((issues+1)); fi
    printf "\n[System]\n"
    local distro; distro=$(ui_detect_distro)
    printf "  Distribution: %s\n" "$distro"
    [[ "$distro" == "unknown" ]] && { printf "  [WARN] Unknown distro\n"; issues=$((issues+1)); }
    printf "\n[Nix]\n"
    ui_has_nix && printf "  [OK] Nix: %s\n" "$(nix-env --version 2>/dev/null || echo unknown)" || printf "  [INFO] Nix not installed\n"
    printf "\n[AUR]\n"
    if ui_is_arch; then
        printf "  [OK] Arch-based\n"
        command -v makepkg >/dev/null 2>&1 && printf "  [OK] makepkg\n" || { printf "  [FAIL] makepkg missing\n"; issues=$((issues+1)); }
        command -v git >/dev/null 2>&1 && printf "  [OK] git\n" || { printf "  [FAIL] git missing\n"; issues=$((issues+1)); }
    else
        printf "  [INFO] Not Arch-based\n"
    fi
    printf "\n[Directories]\n"
    for d in "$UI_CONFIG_DIR" "$UI_DATA_DIR"; do
        [[ -d "$d" && -w "$d" ]] && printf "  [OK] %s\n" "$d" || printf "  [INFO] %s not ready\n" "$d"
    done
    printf "\n[Database]\n"
    [[ -f "$UI_DB" ]] && printf "  [OK] %s packages tracked\n" "$(ui_db_count)" || printf "  [INFO] DB not initialized\n"
    printf "\n[Config]\n"
    [[ -f "$UI_CONFIG_FILE" ]] && printf "  [OK] Config found\n" || { printf "  [WARN] Config missing\n"; issues=$((issues+1)); }
    printf "\n[AUR Health]\n"
    if ui_is_arch && [[ -d "${UI_AUR_DIR}" ]]; then
        local out=0
        for p in "${UI_AUR_DIR}"/*; do
            [[ -d "$p" ]] || continue
            local pkg; pkg=$(basename "$p")
            [[ "$(ui_aur_check_updates "$pkg")" == "outdated" ]] && { printf "  [WARN] Outdated: %s\n" "$pkg"; out=$((out+1)); }
        done
        [[ $out -eq 0 ]] && printf "  [OK] All AUR packages up to date\n"
    fi
    printf "\n[Conflicts]\n"
    local conflicts=0
    while IFS='|' read -r pkg src _; do
        [[ -z "$pkg" ]] && continue
        local other=""
        [[ "$src" == "native" && $(ui_has_nix && nix-env -q "$pkg" >/dev/null 2>&1 && echo 1) ]] && other="nix"
        [[ "$src" == "nix" ]] && case "$(ui_detect_distro)" in arch) pacman -Q "$pkg" >/dev/null 2>&1 && other="native" ;; debian) dpkg -l "$pkg" >/dev/null 2>&1 && other="native" ;; fedora|yum) rpm -q "$pkg" >/dev/null 2>&1 && other="native" ;; esac
        [[ -n "$other" ]] && { printf "  [WARN] '%s' in %s and %s\n" "$pkg" "$src" "$other"; conflicts=$((conflicts+1)); }
    done < <(ui_db_list)
    [[ $conflicts -eq 0 ]] && printf "  [OK] No conflicts\n"
    printf "\n[Summary]\n"
    [[ $issues -eq 0 ]] && ui_ok "Healthy." || ui_warn "${issues} issue(s) found."
}
main "$@"
