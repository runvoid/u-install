# Normalize line endings: the repo stores text files with LF, which keeps
# the shell scripts runnable on Linux regardless of the contributor's OS.
* text=auto eol=lf

# Executable shell commands and the shared library are always LF.
install     text eol=lf
u-*         text eol=lf
*.sh        text eol=lf
*.bats      text eol=lf
*.conf      text eol=lf
*.u         text eol=lf

# Common binary assets (future-proofing) must not be altered by Git.
*.png binary
*.jpg binary
*.gif binary
*.gz  binary
*.zip binary
