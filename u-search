#!/usr/bin/env bash
set -euo pipefail
UI_LIB="${HOME}/.local/share/u-install/lib/u-install.sh"
if [[ -f "$UI_LIB" ]]; then
    source "$UI_LIB"
else
    echo "Run ./install first" >&2
    exit 1
fi
ui_parse_config
usage() { cat <<EOF
u-search ${UI_VERSION}

Search for a package across native, Nix and AUR sources.

Usage: u-search [OPTIONS] <PACKAGE...>

Options:
  -i, --install  After searching, pick a source from a menu and install
  --no-cache     Skip the search cache and refresh results
  -V, --version  Show version information
  -h, --help  Show this help message
EOF
}
# probe one source with caching: prints "version|status"
probe_cached() {
    local source="$1" pkg="$2" row ver status
    if [[ "$use_cache" -eq 1 ]]; then
        row="$(ui_search_cached "$source" "$pkg" 2>/dev/null || true)"
    else
        row=""
    fi
    if [[ -n "$row" ]]; then
        printf '%s' "$row"
        return 0
    fi
    ver="" status="not found"
    case "$source" in
        native)
            if ui_native_search "$pkg" 2>/dev/null; then
                ver="$(ui_native_search_version "$pkg")"
                status="available"
            fi
            ;;
        nix)
            if ui_has_nix && ui_nix_search "$pkg" 2>/dev/null; then
                ver="$(ui_nix_search_version "$pkg")"
                status="available"
            fi
            ;;
        aur)
            if ui_aur_search "$pkg" 2>/dev/null; then
                ver="$(ui_aur_search_version "$pkg")"
                status="available"
            fi
            ;;
    esac
    if [[ "$use_cache" -eq 1 ]]; then
        ui_search_cache_write "$source" "$pkg" "${ver}|${status}"
    fi
    printf '%s|%s' "$ver" "$status"
}
# Interactive source picker for -i: shows available sources for the
# package and hands the choice off to u-install.
pick_and_install() {
    local pkg="$1" ns="$2" nv="$3" nxs="$4" nxv="$5" as="$6" av="$7"
    if [[ ! -t 0 ]]; then
        ui_warn "--install ignored: stdin is not a terminal"
        return 0
    fi
    local opts=() labels=()
    [[ "$ns"  == "available" ]] && { opts+=("native"); labels+=("native  ${nv:-latest}"); }
    [[ "$nxs" == "available" ]] && { opts+=("nix");    labels+=("nix     ${nxv:-latest}"); }
    [[ "$as"  == "available" ]] && { opts+=("aur");    labels+=("aur     ${av:-latest}"); }
    if [[ ${#opts[@]} -eq 0 ]]; then
        ui_info "No available source for '${pkg}'."
        return 0
    fi
    printf "\n  Install '%s' from which source?\n" "$pkg"
    local i
    for i in "${!opts[@]}"; do
        printf "    %d) %s\n" "$((i+1))" "${labels[$i]}"
    done
    printf "    0) cancel\n  Choice [0-%d]: " "${#opts[@]}"
    local pick; read -r pick || pick=0
    if [[ "$pick" =~ ^[0-9]+$ ]] && [[ "$pick" -ge 1 && "$pick" -le "${#opts[@]}" ]]; then
        local src="${opts[$((pick-1))]}"
        ui_info "Running: u-install --${src} ${pkg}"
        "${UI_BIN_DIR}/u-install" "--${src}" "$pkg" || ui_warn "Install cancelled or failed"
    else
        ui_info "Cancelled."
    fi
}
main() {
    local packages=() use_cache=1 interactive=0
    for arg in "$@"; do
        case "$arg" in
            -h|--help) usage; exit 0 ;;
            -V|--version) ui_print_version; exit 0 ;;
            -i|--install) interactive=1 ;;
            --no-cache) use_cache=0 ;;
            -*) ui_warn "Unknown option: $arg" ;;
            *) packages+=("$arg") ;;
        esac
    done
    [[ ${#packages[@]} -eq 0 ]] && { usage; exit 1; }
    local distro; distro=$(ui_detect_distro)
    local total=${#packages[@]} idx=0
    for pkg in "${packages[@]}"; do
        idx=$((idx+1))
        ui_valid_pkg_name "$pkg" || { ui_err "Invalid package name: '${pkg}'"; exit 1; }
        ui_progress "$idx" "$total" "searching ${pkg}"
        ui_progress_break
        ui_info "Searching: ${pkg}"
        printf "\n  %-10s %-20s %-15s %s\n" "SOURCE" "PACKAGE" "VERSION" "STATUS"
        printf "  %-10s %-20s %-15s %s\n" "----------" "--------------------" "---------------" "----------"
        # Native
        local row nv ns
        row="$(probe_cached native "$pkg")"
        nv="${row%%|*}"; ns="${row##*|}"
        printf "  %-10s %-20s %-15s %s\n" "native" "$pkg" "${nv:-""}" "$(ui_fmt_status "$ns")"
        # Nix
        local nxv="" nxs="not found"
        if ui_has_nix; then
            row="$(probe_cached nix "$pkg")"
            nxv="${row%%|*}"; nxs="${row##*|}"
        else
            nxs="Nix not installed"
        fi
        printf "  %-10s %-20s %-15s %s\n" "nix" "$pkg" "${nxv:-""}" "$(ui_fmt_status "$nxs")"
        # AUR
        local av="" as="not found"
        if [[ "$distro" == "arch" ]]; then
            row="$(probe_cached aur "$pkg")"
            av="${row%%|*}"; as="${row##*|}"
        else
            as="Arch only"
        fi
        printf "  %-10s %-20s %-15s %s\n" "aur" "$pkg" "${av:-""}" "$(ui_fmt_status "$as")"
        printf "\n"
        if [[ "$interactive" -eq 1 ]]; then
            pick_and_install "$pkg" "$ns" "$nv" "$nxs" "$nxv" "$as" "$av"
        fi
    done
}
main "$@"
